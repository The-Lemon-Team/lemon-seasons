# ==============================================================================
# Fly.io Secrets & Environment Variables for Lemon Seasons & Lemon Bus
# To set secrets on Fly.io, run:
# fly secrets set DATABASE_URL="postgresql://..." SUPABASE_URL="https://..."
# ==============================================================================

# 1. Server Configuration
PORT=8080
NODE_ENV=production
DEVICE_ID=fly-cloud-bus

# 2. Storage & Database (Permanent Cold Storage Single Source of Truth)
# Supabase PostgreSQL or Fly Postgres connection string:
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?schema=public&sslmode=require"

# 3. Lemon Bus Configuration (30-Day Sliding Buffer & Sub-80ms Realtime)
# Options: 'supabase' (recommended for serverless cloud), 'hybrid', 'memory'
LEMON_BUS_DRIVER=supabase
ENABLE_LOCAL_FS_WATCHER=false

# 4. Supabase Cloud Bus & Spark Document Hub
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_REALTIME_ENABLED=true

# 5. Security & Authentication
JWT_SECRET="generate-a-secure-random-secret-string-here"
ADMIN_TOKEN="your-secure-admin-api-token"
CORS_ORIGIN="*"

# 6. Safety Guarantee
# Notes in Google Drive (Sparks/**/*.md) are NEVER deleted or purged by the bus.
# The 30-day TTL applies strictly to temporary cloud buffer tables (lemon_bus_events).
