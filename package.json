{
  "name": "lemon-seasons",
  "version": "1.0.0",
  "private": true,
  "description": "Lemon Seasons - Collaborative Calendar & Chronological Knowledge Hub for Events, Notes, and Community Feeds",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:local": "turbo run dev --filter=lemon-lenta-backend --filter=@lenta/calendar-app --filter=lemon-seasons-admin --filter=@lenta/feed-app",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "stats": "curl.exe -s http://localhost:3001/stats",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "pnpm run backend:prisma:migrate && pnpm run backend:prisma:seed",
    "prod:build": "turbo run build && docker compose build",
    "prod:up": "docker compose up -d",
    "prod:down": "docker compose down",
    "prod:logs": "docker compose logs -f --tail=100",
    "prod:status": "docker compose ps",
    "backend:dev": "pnpm --filter lemon-lenta-backend run start:dev",
    "backend:build": "pnpm --filter lemon-lenta-backend run build",
    "backend:prisma:generate": "pnpm --filter lemon-lenta-backend run prisma:generate",
    "backend:prisma:migrate": "pnpm --filter lemon-lenta-backend run prisma:migrate",
    "backend:prisma:seed": "pnpm --filter lemon-lenta-backend run prisma:seed",
    "sparks:sync": "node scripts/ingest-sparks-gdrive.mjs",
    "admin:dev": "pnpm --filter lemon-seasons-admin run dev",
    "admin:build": "pnpm --filter lemon-seasons-admin run build",
    "calendar:dev": "pnpm --filter @lenta/calendar-app run dev",
    "calendar:build": "pnpm --filter @lenta/calendar-app run build",
    "feed:dev": "pnpm --filter @lenta/feed-app run dev",
    "feed:public:dev": "pnpm --filter @lenta/feed-app run dev:public",
    "feed:build": "pnpm --filter @lenta/feed-app run build",
    "shared:build": "pnpm --filter @lenta/shared run build",
    "plugin:build": "pnpm --filter @lemon/obsidian-lenta-plugin run build",
    "plugin:dev": "pnpm --filter @lemon/obsidian-lenta-plugin run dev",
    "plugin:test": "pnpm --filter @lemon/obsidian-lenta-plugin test",
    "plugin:e2e": "pnpm --filter @lemon/obsidian-lenta-plugin run test:e2e",
    "plugin:e2e:phase2": "pnpm --filter @lemon/obsidian-lenta-plugin run test:e2e:phase2",
    "mobile:build": "cmd /c \"set JAVA_HOME=C:\\Program Files\\Microsoft\\jdk-17.0.19.10-hotspot && cd apps/mobile-android && gradlew.bat assembleDebug\""
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  }
}
