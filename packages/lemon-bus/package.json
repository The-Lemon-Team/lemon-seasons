{
  "name": "@lenta/lemon-bus",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Reactive Cloud Event Bus & Spark Document Pipeline (Supabase Realtime, Google Drive Cloud/FS, Hybrid)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "start": "node --experimental-sqlite dist/server/index.js",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "node --experimental-sqlite --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
