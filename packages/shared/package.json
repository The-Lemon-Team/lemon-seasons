{
  "name": "@lenta/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types, schemas, DTOs, and utilities for Project Lenta / Lemon Seasons",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
