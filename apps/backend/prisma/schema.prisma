generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Feed {
  id          String    @id @default(uuid())
  title       String
  description String?
  slug        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  notes       Note[]
}

model Note {
  id             String         @id @default(uuid())
  feedId         String?
  containerId    String?
  filePath       String?
  title          String
  description    String?
  type           NoteType       @default(SINGLE)
  startDate      DateTime       @default(now())
  endDate        DateTime?
  sourceLink     String?
  icon           String?
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  curator        String?
  parentNoteId   String?
  resonanceScore Int?
  container      Container?     @relation(fields: [containerId], references: [id], onDelete: Cascade)
  feed           Feed?          @relation(fields: [feedId], references: [id])
  parentNote     Note?          @relation("NoteSynthesis", fields: [parentNoteId], references: [id])
  childNotes     Note[]         @relation("NoteSynthesis")
  folders        NoteFolder[]
  images         NoteImage[]
  links          NoteLink[]
  versions       NoteVersion[]
  hashtags       Hashtag[]      @relation("HashtagToNote")
  tags           TaxonomyNode[] @relation("NoteToTaxonomyNode")

  @@index([startDate, endDate])
  @@index([updatedAt])
  @@index([feedId])
  @@index([containerId])
  @@index([feedId, deletedAt])
  @@index([deletedAt])
  @@index([type])
  @@index([curator])
  @@index([resonanceScore])
  @@index([parentNoteId])
}

model Folder {
  id          String       @id @default(uuid())
  name        String
  path        String
  icon        String?
  color       String?
  privacy     String       @default("public")
  containerId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  container   Container?   @relation(fields: [containerId], references: [id], onDelete: Cascade)
  noteFolders NoteFolder[]

  @@index([path])
  @@index([containerId])
  @@index([updatedAt])
  @@index([deletedAt])
}

model NoteFolder {
  id        String   @id @default(uuid())
  noteId    String
  folderId  String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, folderId])
  @@index([noteId])
  @@index([folderId])
  @@index([noteId, isPrimary])
}

model Hashtag {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  notes     Note[]    @relation("HashtagToNote")

  @@index([name])
  @@index([updatedAt])
  @@index([deletedAt])
}

model NoteImage {
  id           String   @id @default(uuid())
  noteId       String
  url          String
  thumbnailUrl String?
  filename     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  caption      String?
  alt          String?
  isMain       Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  note         Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([noteId, isMain])
  @@index([noteId, order])
}

model NoteLink {
  id        String   @id @default(uuid())
  noteId    String
  url       String
  title     String?
  isSource  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([noteId, isSource])
  @@index([noteId, order])
}

model TaxonomyNode {
  id        String    @id @default(uuid())
  name      String
  path      String    @unique
  icon      String?
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  notes     Note[]    @relation("NoteToTaxonomyNode")

  @@index([path])
  @@index([deletedAt])
}

model Container {
  id          String    @id @default(uuid())
  name        String
  type        String    @default("obsidian")
  description String?
  visibility  String    @default("public")
  ownerUserId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  ownerUser   User?     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  folders     Folder[]
  notes       Note[]

  @@index([ownerUserId])
  @@index([visibility])
}

model NoteVersion {
  id            String   @id @default(uuid())
  noteId        String
  version       Int      @default(1)
  content       String
  commitHash    String?
  authorName    String?
  authorEmail   String?
  commitMessage String?
  createdAt     DateTime @default(now())
  note          Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([commitHash])
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  name       String
  password   String?
  role       String      @default("user")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  containers Container[]
  keys       UserKey[]
}

model UserKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  provider   String
  key        String    @unique
  lastUsedAt DateTime?
  isRevoked  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
}

model ChatFolder {
  id        String       @id @default(uuid())
  name      String
  path      String       @unique
  icon      String?
  color     String?
  order     Int          @default(0)
  parentId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  parent    ChatFolder?  @relation("ChatFolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  ChatFolder[] @relation("ChatFolderHierarchy")
  threads   ChatThread[]

  @@index([path])
  @@index([parentId])
  @@index([deletedAt])
}

model ChatThread {
  id                String              @id @default(uuid())
  title             String
  type              ChatType            @default(DIRECT)
  folderId          String?
  targetAgent       String?
  participantAgents String[]            @default([])
  dateScope         String?
  isPinned          Boolean             @default(false)
  isArchived        Boolean             @default(false)
  lastMessageAt     DateTime?           @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  messages          ChatMessageRecord[]
  folder            ChatFolder?         @relation(fields: [folderId], references: [id])

  @@index([folderId])
  @@index([type])
  @@index([targetAgent])
  @@index([isPinned, lastMessageAt])
  @@index([deletedAt])
}

model ChatMessageRecord {
  id             String     @id @default(uuid())
  threadId       String
  sender         String
  senderName     String
  senderRole     String
  avatar         String?
  text           String
  resonanceScore Int?
  sources        String[]   @default([])
  resonanceNodes Json?
  groupSummary   Json?
  suggestedCard  Json?
  createdAt      DateTime   @default(now())
  thread         ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

enum NoteType {
  SINGLE
  PERIOD
  EVENT
  FILM_RELEASE
  MENTION
  DONE
}

enum ChatType {
  DIRECT
  GROUP
}

model SyncSession {
  id        String          @id @default(uuid())
  title     String
  deviceId  String
  author    String
  status    String          @default("ACTIVE") // ACTIVE, COMMITTED, CANCELLED
  startedAt DateTime        @default(now())
  closedAt  DateTime?
  summary   String?
  changes   PendingChange[]
  commit    SyncCommit?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
  @@index([deviceId])
  @@index([startedAt])
}

model PendingChange {
  id         String      @id @default(uuid())
  sessionId  String
  session    SyncSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  entityType String      // NOTE, CHAT_THREAD, CHAT_MESSAGE, LINK, FOLDER, TAG
  entityId   String
  action     String      // UPSERT, DELETE, INSERT
  payload    Json
  createdAt  DateTime    @default(now())

  @@index([sessionId])
  @@index([entityType, entityId])
}

model SyncCommit {
  id              String       @id // Hash or UUID of the commit
  parentCommitIds String[]     @default([])
  deviceId        String
  author          String
  sessionId       String?      @unique
  session         SyncSession? @relation(fields: [sessionId], references: [id])
  summary         String?
  entitiesCount   Int          @default(0)
  payloadJson     Json         // Full sealed CommitPackage
  isPushed        Boolean      @default(false)
  pushedAt        DateTime?
  createdAt       DateTime     @default(now())

  @@index([deviceId])
  @@index([createdAt])
  @@index([isPushed])
}
