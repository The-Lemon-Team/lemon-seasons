generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Feed {
  id          String    @id @default(uuid())
  title       String
  description String?
  slug        String    @unique
  icon        String?
  color       String?
  privacy     String    @default("public")
  ownerUserId String?
  folderPaths String[]  @default([])
  hashtags    String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  ownerUser   User?       @relation("FeedOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  notes       Note[]
  publicNotes Note[]      @relation("NotePublicFeed")
  streamTabs  StreamTab[]
  shares      FeedShare[]

  @@index([privacy])
  @@index([ownerUserId])
}

model Note {
  id             String         @id @default(uuid())
  feedId         String?
  publicFeedId   String?
  privacy        String         @default("private")
  ownerUserId    String?
  containerId    String?
  status         NoteStatus     @default(PUBLISHED)
  publishAt      DateTime?
  folderPath     String?
  filePath       String?
  title          String
  description    String?
  type           NoteType       @default(SINGLE)
  startDate      DateTime       @default(now())
  endDate        DateTime?
  sourceLink     String?
  sourceType     String?        @default("MANUAL")
  externalId     String?
  rawContent     String?
  summary        String?
  metadata       Json?
  processingStatus String?      @default("COMPLETED")
  icon           String?
  version        Int            @default(1)
  // English language variants (optional)
  titleEng       String?
  descriptionEng String?
  rawContentEng  String?
  summaryEng     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  fieldClocks    Json?
  deletedHlc     String?
  attachments    NoteAttachment[]
  author         String?
  parentNoteId   String?
  resonanceScore Int?
  container      Container?     @relation(fields: [containerId], references: [id], onDelete: Cascade)
  ownerUser      User?          @relation("NoteOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  feed           Feed?          @relation(fields: [feedId], references: [id])
  publicFeed     Feed?          @relation("NotePublicFeed", fields: [publicFeedId], references: [id])
  parentNote     Note?          @relation("NoteSynthesis", fields: [parentNoteId], references: [id])
  childNotes     Note[]         @relation("NoteSynthesis")
  folders        NoteFolder[]
  images         NoteImage[]
  links          NoteLink[]
  versions       NoteVersion[]
  hashtags       Hashtag[]      @relation("HashtagToNote")
  tags           TaxonomyNode[] @relation("NoteToTaxonomyNode")
  ingestionFiles IngestionFile[]
  workspacePins  WorkspacePin[]
  shares         NoteShare[]

  @@index([startDate, endDate])
  @@index([deletedAt, startDate(sort: Desc)])
  @@index([containerId, deletedAt, startDate(sort: Desc)])
  @@index([updatedAt])
  @@index([feedId])
  @@index([ownerUserId, privacy])
  @@index([containerId])
  @@index([feedId, deletedAt])
  @@index([deletedAt])
  @@index([type])
  @@index([author])
  @@index([resonanceScore])
  @@index([parentNoteId])
  @@index([sourceType])
  @@index([externalId])
  @@index([processingStatus])
  @@index([status])
  @@index([publishAt])
  @@index([folderPath])
  @@index([privacy])
  @@index([privacy, status])
  @@index([publicFeedId])
}

model Folder {
  id          String       @id @default(uuid())
  name        String
  path        String
  icon        String?
  color       String?
  privacy     String       @default("public")
  containerId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  container   Container?   @relation(fields: [containerId], references: [id], onDelete: Cascade)
  noteFolders NoteFolder[]

  @@index([path])
  @@index([containerId])
  @@index([containerId, deletedAt, path])
  @@index([privacy, deletedAt])
  @@index([updatedAt])
  @@index([deletedAt])
}

model NoteFolder {
  id        String   @id @default(uuid())
  noteId    String
  folderId  String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, folderId])
  @@index([noteId])
  @@index([folderId])
  @@index([noteId, isPrimary])
}

model Hashtag {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  notes     Note[]    @relation("HashtagToNote")

  @@index([updatedAt])
  @@index([deletedAt])
}

model NoteImage {
  id           String   @id @default(uuid())
  noteId       String
  url          String
  thumbnailUrl String?
  filename     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  caption      String?
  alt          String?
  isMain       Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  note         Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([noteId, isMain])
  @@index([noteId, order])
}

model NoteLink {
  id        String   @id @default(uuid())
  noteId    String
  url       String
  title     String?
  isSource  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([noteId, isSource])
  @@index([noteId, order])
}

model TaxonomyNode {
  id        String    @id @default(uuid())
  name      String
  path      String    @unique
  icon      String?
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  notes     Note[]    @relation("NoteToTaxonomyNode")

  @@index([deletedAt])
}

model Container {
  id          String    @id @default(uuid())
  name        String
  type        String    @default("obsidian")
  description String?
  visibility  String    @default("public")
  ownerUserId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  ownerUser   User?     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  folders     Folder[]
  notes       Note[]

  @@index([ownerUserId])
  @@index([visibility])
}

model NoteVersion {
  id            String   @id @default(uuid())
  noteId        String
  version       Int      @default(1)
  content       String
  commitHash    String?
  authorName    String?
  authorEmail   String?
  commitMessage String?
  createdAt     DateTime @default(now())
  note          Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([noteId, createdAt(sort: Desc)])
  @@index([commitHash])
}

model User {
  id                 String      @id @default(uuid())
  email              String      @unique
  name               String
  password           String?
  role               String      @default("user")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  containers         Container[]
  keys               UserKey[]
  ownedNotes         Note[]      @relation("NoteOwner")
  ownedFeeds         Feed[]      @relation("FeedOwner")
  ownedStreams       Stream[]    @relation("StreamOwner")
  receivedNoteShares NoteShare[] @relation("NoteShareGrantee")
  grantedNoteShares  NoteShare[] @relation("NoteShareGrantor")
  receivedFeedShares FeedShare[] @relation("FeedShareGrantee")
}

model NoteShare {
  id              String    @id @default(uuid())
  noteId          String
  granteeUserId   String
  grantedByUserId String
  scopeType       String    @default("USER") // USER | TIMELINE_GROUP
  scopeRef        String?   // e.g. timeline boardId when shared to a Timeline group
  canReadMedia    Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  note          Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  granteeUser   User @relation("NoteShareGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade)
  grantedByUser User @relation("NoteShareGrantor", fields: [grantedByUserId], references: [id], onDelete: Cascade)

  @@unique([noteId, granteeUserId, scopeType, scopeRef])
  @@index([granteeUserId])
  @@index([noteId])
  @@index([scopeRef])
}

model FeedShare {
  id              String   @id @default(uuid())
  feedId          String
  granteeUserId   String
  grantedByUserId String
  permission      String   @default("READ") // READ | WRITE
  createdAt       DateTime @default(now())

  feed        Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  granteeUser User @relation("FeedShareGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade)

  @@unique([feedId, granteeUserId])
  @@index([granteeUserId])
}

model UserKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  provider   String
  key        String    @unique
  lastUsedAt DateTime?
  isRevoked  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
}

enum NoteType {
  SINGLE
  PERIOD
  EVENT
  FILM_RELEASE
  MENTION
  DONE
}

enum NoteStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model SyncSession {
  id        String          @id @default(uuid())
  title     String
  deviceId  String
  author    String
  status    String          @default("ACTIVE") // ACTIVE, COMMITTED, CANCELLED
  startedAt DateTime        @default(now())
  closedAt  DateTime?
  summary   String?
  changes   PendingChange[]
  commit    SyncCommit?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
  @@index([deviceId])
  @@index([deviceId, status])
  @@index([startedAt])
}

model PendingChange {
  id         String      @id @default(uuid())
  sessionId  String
  session    SyncSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  entityType String      // NOTE, CHAT_THREAD, CHAT_MESSAGE, LINK, FOLDER, TAG
  entityId   String
  action     String      // UPSERT, DELETE, INSERT
  payload    Json
  createdAt  DateTime    @default(now())

  @@index([sessionId])
  @@index([entityType, entityId])
}

model SyncCommit {
  id              String       @id // Hash or UUID of the commit
  parentCommitIds String[]     @default([])
  deviceId        String
  author          String
  sessionId       String?      @unique
  session         SyncSession? @relation(fields: [sessionId], references: [id])
  summary         String?
  entitiesCount   Int          @default(0)
  payloadJson     Json         // Full sealed CommitPackage
  isPushed        Boolean      @default(false)
  pushedAt        DateTime?
  createdAt       DateTime     @default(now())

  @@index([deviceId])
  @@index([createdAt])
  @@index([isPushed])
}

model IngestionFile {
  id           String   @id @default(uuid())
  filePath     String   @unique
  fileName     String
  fileHash     String
  fileSize     Int?
  mtime        DateTime
  status       String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  errorMessage String?
  noteId       String?
  note         Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([fileHash])
  @@index([noteId])
}

model NoteAttachment {
  id        String    @id
  noteId    String
  kind      String
  title     String
  content   String
  meta      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  note      Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, deletedAt])
  @@index([kind])
}

model SyncEventLog {
  eventId    String   @id
  deviceId   String
  entityType String
  entityId   String
  hlc        String
  outcome    String
  appliedAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([hlc])
}

model Workspace {
  id          String           @id @default(uuid())
  title       String
  slug        String           @unique
  icon        String?          @default("layout")
  color       String?          @default("#2481cc")
  description String?
  isDefault   Boolean          @default(false)
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  tracks      WorkspaceTrack[]
  pins        WorkspacePin[]

  @@index([slug])
  @@index([deletedAt])
  @@index([order])
}

model WorkspaceTrack {
  id           String         @id @default(uuid())
  workspaceId  String
  title        String
  color        String?
  icon         String?
  periodNoteId String?
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pins         WorkspacePin[]

  @@index([workspaceId])
  @@index([periodNoteId])
  @@index([deletedAt])
  @@index([workspaceId, order])
}

model WorkspacePin {
  id          String          @id @default(uuid())
  workspaceId String
  trackId     String?
  noteId      String
  isPinned    Boolean         @default(false)
  status      String          @default("ACTIVE") // ACTIVE, NEEDS_ATTENTION, REVIEWED, ARCHIVED
  comment     String?
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  track       WorkspaceTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)
  note        Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, noteId])
  @@index([workspaceId])
  @@index([workspaceId, isPinned])
  @@index([workspaceId, trackId])
  @@index([noteId])
  @@index([status])
}


model QuickAddMacro {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?  @default("zap")
  color       String?  @default("#f59e0b")
  feedId      String?
  folderPath  String?
  folderPaths String[] @default([])
  noteType    String?  @default("SINGLE")
  hashtags    String[] @default([])
  order       Int      @default(0)
  isDefault   Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Stream {
  id               String      @id @default(uuid())
  slug             String      @unique
  title            String
  description      String?
  icon             String?     @default("📁")
  color            String?     @default("#2481cc")
  badge            String?
  privacy          String      @default("public")
  ownerUserId      String?
  order            Int         @default(0)
  isBuiltin        Boolean     @default(false)
  feedIds          String[]    @default([])
  childStreamIds   String[]    @default([])
  tags             String[]    @default([])
  folderPaths      String[]    @default([])
  ownerUser        User?       @relation("StreamOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  tabs             StreamTab[] @relation("StreamOwnedTabs")
  referencedByTabs StreamTab[] @relation("StreamTabTarget")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  @@index([privacy])
  @@index([ownerUserId])
  @@index([order])
  @@index([slug])
  @@index([deletedAt])
}

model StreamTab {
  id             String    @id @default(uuid())
  streamId       String
  stream         Stream    @relation("StreamOwnedTabs", fields: [streamId], references: [id], onDelete: Cascade)

  feedId         String?
  feed           Feed?     @relation(fields: [feedId], references: [id], onDelete: Cascade)

  targetStreamId String?
  targetStream   Stream?   @relation("StreamTabTarget", fields: [targetStreamId], references: [id], onDelete: Cascade)

  type           String    @default("feed")
  targetSlug     String?

  customTitle    String?
  customIcon     String?
  badge          String?
  order          Int       @default(0)
  isHidden       Boolean   @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([streamId, feedId])
  @@unique([streamId, targetStreamId])
  @@index([streamId, order])
  @@index([feedId])
  @@index([targetStreamId])
}
