{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lenta Feed",
  "version": "0.1.0",
  "identifier": "team.lemon.lenta.feed",
  "build": {
    "beforeDevCommand": "pnpm --filter @lenta/feed-app dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "pnpm --filter @lenta/feed-app build",
    "frontendDist": "../../feed-app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lenta Feed",
        "width": 420,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
